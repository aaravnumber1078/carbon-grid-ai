# CarbonGrid-AI Environment Configuration
# Copy to .env and customize for your deployment
# DO NOT commit .env files with real secrets

# Server Configuration
HOST=0.0.0.0
PORT=7860

# Model Configuration
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
DEVICE_INDEX=0
MAX_CONCURRENT=1

# Carbon Provider Configuration
# Options: live, replay, offline
CARBON_MODE=live
CARBON_CONNECT_TIMEOUT=3.0
CARBON_READ_TIMEOUT=7.0

# VRAM Thresholds (MB) - Decision Engine resource feasibility
FP16_VRAM_MB=3200
INT4_VRAM_MB=1400

# Hugging Face Token (for private/gated models)
# HF_TOKEN=your_token_here

# Optional: Override decision profile
# Options: phase05, b2_workload
# DECISION_PROFILE=phase05